# ── Local development / dry run ──────────────────────────────────────────
# Set DRY_RUN=true to run the entire pipeline — including the real
# analysis engine — with zero GCP or Gemini credentials. main.py runs
# the pipeline in-process (no worker service, no Cloud Tasks call), and
# gemini_agent.py's two AI calls (triage, explain) return clearly-labeled
# canned output instead of hitting the real API. Everything else
# (Firestore job tracking -> in-memory store, the actual heuristic +
# schema-aware analysis logic) behaves identically to production.
DRY_RUN=true

# ── Google Cloud project (required when DRY_RUN is not set) ─────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── Firestore ─────────────────────────────────────────────────────────────
# Collection name for job documents. No credentials needed here beyond
# GOOGLE_CLOUD_PROJECT above — Cloud Run supplies Application Default
# Credentials automatically via its attached service account.
FIRESTORE_COLLECTION=queryagent_jobs

# ── Cloud Tasks (main.py's enqueue target) ───────────────────────────────
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=queryagent-pipeline
# The worker service's public HTTPS URL, e.g. https://queryagent-worker-xxxx-uc.a.run.app
WORKER_URL=https://your-worker-service-url.a.run.app
# Service account Cloud Tasks uses to mint the OIDC token worker.py's
# Cloud Run IAM policy checks — see README's deploy section for how this
# is created and bound.
WORKER_SERVICE_ACCOUNT=queryagent-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com

# ── Shared secret (worker.py, defense in depth on top of Cloud Run IAM) ──
# Any long random string — set the same value on both the main.py-side
# enqueue call and the worker.py deployment's own env vars.
TASK_SECRET=change-me-to-a-real-random-value

# ── Google AI stack — Gemini/Gemma via google-adk (adk_agents.py) ────────
# Two ways to authenticate; gemini_agent.py checks for either at startup
# and uses whichever is configured (Vertex AI wins if both are set).
#
# Option A — Gemini Developer API (AI Studio). Simplest for local dev and
# for judges spinning this up quickly: get a key at
# https://aistudio.google.com/apikey, no GCP billing setup required.
GEMINI_API_KEY=your-gemini-api-key

# Option B — Vertex AI (the more "native GCP" path — no separate API key
# at all; Cloud Run's attached service account authenticates via
# Application Default Credentials). Set both of these and leave
# GEMINI_API_KEY blank to use it instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=us-central1

# Fast/cheap model for the triage step (Gemma via the Gemini API's
# OpenAI-compatible-model-name routing) — swap for a Gemma model served
# via Vertex AI Model Garden if you want a literal Gemma endpoint rather
# than a Gemini model, without changing any code, only this value.
GEMMA_TRIAGE_MODEL=gemma-3-27b-it

# Model for the final natural-language explain step.
GEMINI_EXPLAIN_MODEL=gemini-2.0-flash

# Cheap/fast model for the plan step's one-sentence rationale.
GEMINI_PLAN_MODEL=gemini-2.0-flash-lite

# ── CORS (main.py) ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the public API. "*" is fine
# for local dev; set to your actual frontend origin(s) in production.
ALLOWED_ORIGINS=*
